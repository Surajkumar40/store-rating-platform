PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/store_rating?schema=public"
JWT_SECRET=replace_with_a_long_random_string_of_at_least_32_chars
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
# First admin created by `npm run seed`. Change the password right after first login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
